<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@color/search_sticky_header_bg"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_search_album_art">

        <ImageView
            android:id="@+id/ivSearchAlbumArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerInside"
            android:src="@drawable/ic_album"
            android:contentDescription="@null"
            android:tint="@color/text_secondary" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSearchAlbumName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvSearchAlbumMatches"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="8dp">

        <ImageView
            android:id="@+id/btnSearchAlbumAdd"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/ic_playlist_add"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_results_add_album_to_playlist"
            android:tint="@color/text_secondary"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/btnSearchAlbumReplace"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:padding="8dp"
            android:src="@drawable/ic_playlist_replace"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_results_replace_playlist_with_album"
            android:tint="@color/text_secondary"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/btnSearchAlbumExpand"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:padding="8dp"
            android:src="@drawable/ic_expand_more"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_results_expand_album"
            android:tint="@color/text_secondary"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</LinearLayout>
