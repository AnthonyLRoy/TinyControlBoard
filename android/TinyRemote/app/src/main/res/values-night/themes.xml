<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.TinyRemote" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mcintosh_green</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorSecondary">#1B5E20</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/bg_card</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="android:windowBackground">@drawable/bg_main_gradient</item>
        <item name="android:statusBarColor">@color/bg_gradient_top</item>
        <item name="android:navigationBarColor">@color/bg_gradient_bottom</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <!-- Ripple on dark backgrounds -->
        <item name="colorControlHighlight">#22FFFFFF</item>
        <!-- Dark backgrounds need light (white) status/nav bar icons -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>

        <item name="materialAlertDialogTheme">@style/Theme.TinyRemote.AlertDialog</item>
    </style>

    <style name="Widget.TinyRemote.Button.Aluminium" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_button_aluminium</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:elevation">4dp</item>
    </style>

    <style name="Widget.TinyRemote.Button.Aluminium.Dialog" parent="Widget.TinyRemote.Button.Aluminium">
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>

    <style name="Theme.TinyRemote.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/bg_card</item>
        <item name="android:background">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorPrimary">@color/text_primary</item>
        <item name="materialButtonStyle">@style/Widget.TinyRemote.Button.Aluminium.Dialog</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.TinyRemote.Dialog</item>
    </style>

    <style name="ShapeAppearance.TinyRemote.Dialog" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">16dp</item>
    </style>
</resources>
