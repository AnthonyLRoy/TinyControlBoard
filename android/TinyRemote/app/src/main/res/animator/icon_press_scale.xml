<?xml version="1.0" encoding="utf-8"?>
<!-- Subtle press feedback for chrome-less icon buttons: shrink + dim slightly, then spring back. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="0.88" android:valueType="floatType" android:duration="80" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="0.88" android:valueType="floatType" android:duration="80" />
            <objectAnimator android:propertyName="alpha" android:valueTo="0.75" android:valueType="floatType" android:duration="80" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.0" android:valueType="floatType" android:duration="120" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.0" android:valueType="floatType" android:duration="120" />
            <objectAnimator android:propertyName="alpha" android:valueTo="1.0" android:valueType="floatType" android:duration="120" />
        </set>
    </item>
</selector>
