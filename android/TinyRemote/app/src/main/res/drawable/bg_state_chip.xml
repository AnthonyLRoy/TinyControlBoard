<?xml version="1.0" encoding="utf-8"?>
<!-- Pill background for the power-state chip; solid color is swapped at runtime
     via View.backgroundTintList based on the current power state. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="12dp" />
    <solid android:color="@color/state_busy" />
</shape>
