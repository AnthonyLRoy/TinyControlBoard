<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Exterior Shadow for 3D depth -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#80000000" />
        </shape>
    </item>

    <!-- 2. Main Button Body (Anodized Black Aluminium) -->
    <item android:bottom="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:startColor="@color/aluminium_light"
                android:centerColor="@color/aluminium_mid"
                android:endColor="@color/aluminium_dark"
                android:angle="270" />
        </shape>
    </item>

    <!-- 3. Brushed texture (HORIZONTAL Grain) -->
    <item android:bottom="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:startColor="#00000000"
                android:centerColor="#26000000"
                android:endColor="#00000000"
                android:angle="270" />
        </shape>
    </item>

    <!-- 4. Matte satin sheen -->
    <item android:bottom="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:gradientRadius="200dp"
                android:startColor="#1AFFFFFF"
                android:endColor="#00FFFFFF"
                android:type="radial"
                android:centerX="0.4"
                android:centerY="0.3" />
        </shape>
    </item>

    <!-- 5. Fine metallic rim highlight -->
    <item android:bottom="3dp" android:right="3dp" android:left="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="11dp" />
            <stroke android:width="1dp" android:color="@color/aluminium_edge_light" />
        </shape>
    </item>
</layer-list>
