<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Exterior Shadow (Accent Glow) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#403DDC84" />
        </shape>
    </item>

    <!-- 2. Main Button Body (Dark with Accent Border) -->
    <item android:bottom="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#1C1C1E" />
            <stroke android:width="2dp" android:color="@color/menu_accent" />
        </shape>
    </item>

    <!-- 3. Inner Glow/Sheen -->
    <item android:bottom="4dp" android:right="4dp" android:left="2dp" android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#1A3DDC84" />
            <stroke android:width="1dp" android:color="#40FFFFFF" />
        </shape>
    </item>

    <!-- 4. Top-left Highlight -->
    <item android:bottom="4dp" android:right="4dp" android:left="2dp" android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:gradientRadius="150dp"
                android:startColor="#20FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="radial"
                android:centerX="0.2"
                android:centerY="0.2" />
        </shape>
    </item>
</layer-list>
