<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Inset Shadow (darker top/left) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#40000000" />
        </shape>
    </item>

    <!-- Bottom/Right highlight -->
    <item android:top="1dp" android:left="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#20FFFFFF" />
        </shape>
    </item>

    <!-- Content surface (Accent Dim) -->
    <item android:top="1.5dp" android:left="1.5dp" android:bottom="0.5dp" android:right="0.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="11dp" />
            <solid android:color="@color/menu_accent_dim" />
        </shape>
    </item>
</layer-list>
