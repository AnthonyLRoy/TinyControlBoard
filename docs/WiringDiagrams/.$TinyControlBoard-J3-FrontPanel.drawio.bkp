        <mxCell id="eL29" style="endArrow=none;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="LL29" target="p29"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eL31" style="endArrow=none;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="LL31" target="p31"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eL33" style="endArrow=none;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="LL33" target="p33"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eL35" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="GNDL" target="p35"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Wires: right side -->
        <mxCell id="eR4" style="endArrow=none;html=1;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="p4" target="RB4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eR6" style="endArrow=none;html=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="p6" target="RB6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eR8" style="endArrow=none;html=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="p8" target="RB8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eR10" style="endArrow=none;html=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="p10" target="RB10"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eR12" style="endArrow=none;html=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="p12" target="RB12"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eR14" style="endArrow=none;html=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="p14" target="RB14"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eR16" style="endArrow=none;html=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="p16" target="RB16"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eR18" style="endArrow=none;html=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="p18" target="RB18"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eR20" style="endArrow=none;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="p20" target="RL20"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eR22" style="endArrow=none;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="p22" target="RL22"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eR24" style="endArrow=none;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="p24" target="RL24"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eR26" style="endArrow=none;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="p26" target="RL26"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eR28" style="endArrow=none;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="p28" target="RL28"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eR30" style="endArrow=none;html=1;strokeColor=#999999;strokeWidth=1;dashed=1;" edge="1" parent="1" source="p30" target="RL30"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eR32" style="endArrow=none;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="p32" target="RL32"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eR34" style="endArrow=none;html=1;strokeColor=#999999;strokeWidth=1;dashed=1;" edge="1" parent="1" source="p34" target="RL34"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eR36" style="endArrow=none;html=1;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="p40" target="V5R"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ================= Controller side ================= -->
        <mxCell id="hdr2" value="&lt;b&gt;Controller side of J3 (on the TinyControlBoard)&lt;/b&gt;" style="text;html=1;align=center;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="300" y="690" width="400" height="24" as="geometry" />
        </mxCell>

        <mxCell id="MAX" value="&lt;b&gt;IC2 + IC3 · MAX6818&lt;/b&gt;&lt;br&gt;8-ch debouncer / ESD&lt;br&gt;btn_in_1..8 → btn_l_1..8 (IC2)&lt;br&gt;btn_in_9..16 → btn_l_9..16 (IC3)&lt;br&gt;3.3 V supply" style="rounded=1;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="20" y="740" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="MCP" value="&lt;b&gt;IC5 · MCP23018&lt;/b&gt;&lt;br&gt;16-bit I2C expander, addr 0x20&lt;br&gt;GPA/GPB ← btn_l_1..16&lt;br&gt;(rotary A/B decoded in firmware)&lt;br&gt;INTA / INTB → ESP32" style="rounded=1;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="20" y="890" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ESP" value="&lt;b&gt;IC6 · ESP32-S3-WROOM-1U-N16&lt;/b&gt;&lt;br&gt;&lt;br&gt;GPIO15  I2C SCL (mcp_clk, 50 kHz)&lt;br&gt;GPIO16  I2C SDA (mcp_sda)&lt;br&gt;GPIO17  MCP23018 reset/enable&lt;br&gt;GPIO18  MCP interrupt (IntA)&lt;br&gt;GPIO8   MCP interrupt (IntB)&lt;br&gt;&lt;br&gt;GPIO7   STP16 SDI (data)&lt;br&gt;GPIO6   STP16 CLK&lt;br&gt;GPIO5   STP16 LE (latch)&lt;br&gt;GPIO21  STP16 OE / PWM (brightness)&lt;br&gt;&lt;br&gt;GPIO3   on_led (app active)&lt;br&gt;GPIO4   standby_led (sleep)" style="rounded=1;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="380" y="740" width="240" height="250" as="geometry" />
        </mxCell>
        <mxCell id="STP" value="&lt;b&gt;IC1 · STP16CPC26&lt;/b&gt;&lt;br&gt;16-ch constant-current LED driver&lt;br&gt;OUT0..15 = led_o_1..16 (sinks)&lt;br&gt;R-EXT: R7 / R17 + VR1 trimmer&lt;br&gt;3.3 V supply" style="rounded=1;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="740" y="740" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="PWR" value="&lt;b&gt;Power-state indicators&lt;/b&gt;&lt;br&gt;GPIO3 → R → ON LED (D1 on_led)&lt;br&gt;GPIO4 → R → STANDBY LED&lt;br&gt;Front-panel power indicator [18] shows ON / sleep; flashes during start-up&lt;br&gt;&lt;i&gt;(not routed through J3 – see notes)&lt;/i&gt;" style="rounded=1;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="740" y="890" width="230" height="100" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="btn_in_1..16" style="endArrow=classic;html=1;fontSize=10;strokeColor=#6c8ebf;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="j3" target="MAX"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c2" value="btn_l_1..16" style="endArrow=classic;html=1;fontSize=10;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="MAX" target="MCP"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c3" value="I2C SCL/SDA, RESET, INT" style="endArrow=classic;startArrow=classic;html=1;fontSize=10;strokeColor=#d6b656;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="MCP" target="ESP"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c4" value="SDI / CLK / LE / OE(PWM)" style="endArrow=classic;html=1;fontSize=10;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="ESP" target="STP"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c5" value="led_o_1..16 (sink)" style="endArrow=classic;html=1;fontSize=10;strokeColor=#82b366;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="STP" target="j3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c6" value="GPIO3 / GPIO4" style="endArrow=classic;html=1;fontSize=10;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="ESP" target="PWR"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Notes -->
        <mxCell id="notes" value="&lt;b&gt;Notes / assumptions&lt;/b&gt;&lt;br&gt;• J3 pin map from docs/Custom boards/tinyControlBoard/TinyControlboard.md §3; GPIOs from lib/board/boardConfig.hpp and docs/DeveloperGuides/06-hardware-interface.md.&lt;br&gt;• Button ID n (lib/board/boardButtonIds.hpp) is assumed to map to btn_in_(n+1); confirm against the KiCad schematic.&lt;br&gt;• Button inputs: normally-open switch from btn_in_n to GND (MAX6818 inputs). Power switch = ID 0 (short press Sleep/wake, ~3 s hold Deep Sleep).&lt;br&gt;• Rotary: phase A/B = IDs 13/14 (btn_in_14/15), decoded in lib/hal/buttons/mcpInputHandler.cpp. The documented encoder push switch is not identified in the sources – verify its input.&lt;br&gt;• LEDs: STP16 outputs are current sinks, so each LED anode goes to +5 V and cathode to led_o_n (verify on the front-panel PCB). J3 pins 32/34 are led_o_16/led_o_15 (out of sequence).&lt;br&gt;• Power indicators: the documentation lists no J3 pins for them; on_led (GPIO3) and standby_led (GPIO4) are on-board outputs. If the front-panel indicator is wired to them, they leave via test points, not J3. Verify. J3 pins 1/2 are N/C."
 style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fillColor=#ffffcc;strokeColor=#d6b656;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="1020" width="950" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
