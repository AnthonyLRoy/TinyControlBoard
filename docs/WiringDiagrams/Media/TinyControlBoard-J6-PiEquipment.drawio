        <mxCell id="hdr2" parent="1" style="text;html=1;align=center;fontSize=14;" value="&lt;b&gt;Controller side of J6 (on the TinyControlBoard)&lt;/b&gt;" vertex="1">
          <mxGeometry height="24" width="400" x="295" y="720" as="geometry" />
        </mxCell>
        <mxCell id="PI" parent="1" style="rounded=1;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Raspberry Pi 4 (moOde)&lt;/b&gt;&lt;br&gt;UART link 921600 baud&lt;br&gt;Pi TX → J6-4, Pi RX ← J6-3&lt;br&gt;data-ready handshake: J6-9 / J6-11&lt;br&gt;rpi_state: J6-12&lt;br&gt;Pi GPIOs 12/13/23/24 per 01-Rpi4_SETUP.md" vertex="1">
          <mxGeometry height="110" width="250" x="20" y="760" as="geometry" />
        </mxCell>
        <mxCell id="ESP" parent="1" style="rounded=1;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;IC6 · ESP32-S3-WROOM-1U-N16&lt;/b&gt;&lt;br&gt;&lt;br&gt;GPIO2 UART2 TX → J6-3&lt;br&gt;GPIO1 UART2 RX ← J6-4&lt;br&gt;GPIO43/44 TXD0/RXD0 → J6-5/6&lt;br&gt;GPIO41 esp_ir_sent → J6-11&lt;br&gt;GPIO42 rpi4_data_ready ← J6-9&lt;br&gt;GPIO40 rpi_state ← J6-12&lt;br&gt;&lt;br&gt;GPIO47 gen_relay_4&lt;br&gt;GPIO14 dac_on · GPIO13 screen_on&lt;br&gt;GPIO12 switch_dac · GPIO11 mains_power&lt;br&gt;GPIO10 gen_relay_2 · GPIO9 gen_relay_3&lt;br&gt;GPIO39 gen_relay_1&lt;br&gt;(KiCad net names, 3.3 V logic)" vertex="1">
          <mxGeometry height="260" width="240" x="380" y="760" as="geometry" />
        </mxCell>
        <mxCell id="LS" parent="1" style="rounded=1;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;IC7 · TXS0108E&lt;/b&gt;&lt;br&gt;Level shifter&lt;br&gt;VCCA = 3.3 V (ESP32 side)&lt;br&gt;VCCB = 5 V (J6 side)&lt;br&gt;A: gen_relay_1..4, dac_on,&lt;br&gt;screen_on, switch_dac, mains_power&lt;br&gt;B: *_out nets → J6 odd pins 21-35&lt;br&gt;OE = Net-(IC7-OE)" vertex="1">
          <mxGeometry height="130" width="230" x="740" y="760" as="geometry" />
        </mxCell>
        <mxCell id="EQ" parent="1" style="rounded=1;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b&gt;External equipment&lt;/b&gt;&lt;br&gt;DAC power / signal select, screen, mains/relay controls, general relays 1-4&lt;br&gt;(5 V logic-level control lines)" vertex="1">
          <mxGeometry height="90" width="230" x="740" y="930" as="geometry" />
        </mxCell>
