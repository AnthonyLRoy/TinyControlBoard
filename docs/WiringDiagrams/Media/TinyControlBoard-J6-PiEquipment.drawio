        <mxCell id="c5" edge="1" parent="1" source="LS" style="endArrow=classic;html=1;fontSize=10;strokeColor=#b85450;strokeWidth=2;" target="EQ" value="control lines">
          <mxGeometry relative="1" as="geometry" />
