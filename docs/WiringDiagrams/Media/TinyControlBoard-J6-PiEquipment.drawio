        <!-- Controller side -->
        <mxCell id="hdr2" value="&lt;b&gt;Controller side of J6 (on the TinyControlBoard)&lt;/b&gt;" style="text;html=1;align=center;fontSize=14;" vertex="1" parent="1"><mxGeometry x="300" y="710" width="400" height="24" as="geometry" /></mxCell>

        <mxCell id="PI" value="&lt;b&gt;Raspberry Pi 4 (moOde)&lt;/b&gt;&lt;br&gt;UART link 921600 baud&lt;br&gt;Pi TX → J6-4, Pi RX ← J6-3&lt;br&gt;data-ready handshake: J6-9 / J6-11&lt;br&gt;rpi_state: J6-12&lt;br&gt;Pi GPIOs 12/13/23/24 per 01-Rpi4_SETUP.md" style="rounded=1;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="760" width="250" height="110" as="geometry" /></mxCell>
        <mxCell id="ESP" value="&lt;b&gt;IC6 · ESP32-S3-WROOM-1U-N16&lt;/b&gt;&lt;br&gt;&lt;br&gt;GPIO2 UART2 TX → J6-3&lt;br&gt;GPIO1 UART2 RX ← J6-4&lt;br&gt;GPIO43/44 TXD0/RXD0 → J6-5/6&lt;br&gt;GPIO41 esp_ir_sent → J6-11&lt;br&gt;GPIO42 rpi4_data_ready ← J6-9&lt;br&gt;GPIO40 rpi_state ← J6-12&lt;br&gt;&lt;br&gt;GPIO47 gen_relay_4&lt;br&gt;GPIO14 dac_on · GPIO13 screen_on&lt;br&gt;GPIO12 switch_dac · GPIO11 mains_power&lt;br&gt;GPIO10 gen_relay_2 · GPIO9 gen_relay_3&lt;br&gt;GPIO39 gen_relay_1&lt;br&gt;(KiCad net names, 3.3 V logic)" style="rounded=1;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="380" y="760" width="240" height="260" as="geometry" /></mxCell>
        <mxCell id="LS" value="&lt;b&gt;IC7 · TXS0108E&lt;/b&gt;&lt;br&gt;Level shifter&lt;br&gt;VCCA = 3.3 V (ESP32 side)&lt;br&gt;VCCB = 5 V (J6 side)&lt;br&gt;A: gen_relay_1..4, dac_on,&lt;br&gt;screen_on, switch_dac, mains_power&lt;br&gt;B: *_out nets → J6 odd pins 21-35&lt;br&gt;OE = Net-(IC7-OE)" style="rounded=1;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="740" y="760" width="230" height="130" as="geometry" /></mxCell>
        <mxCell id="EQ" value="&lt;b&gt;External equipment&lt;/b&gt;&lt;br&gt;DAC power / signal select, screen, mains/relay controls, general relays 1-4&lt;br&gt;(5 V logic-level control lines)" style="rounded=1;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="740" y="930" width="230" height="90" as="geometry" /></mxCell>

        <mxCell id="c1" value="UART + handshake" style="endArrow=classic;startArrow=classic;html=1;fontSize=10;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="PI" target="j6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c2" value="UART, handshake, state" style="endArrow=classic;startArrow=classic;html=1;fontSize=10;strokeColor=#d6b656;strokeWidth=2;" edge="1" parent="1" source="ESP" target="PI"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c3" value="3.3 V logic outputs" style="endArrow=classic;html=1;fontSize=10;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="ESP" target="LS"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c4" value="*_out (5 V) → J6" style="endArrow=classic;html=1;fontSize=10;strokeColor=#82b366;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="LS" target="j6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c5" value="control lines" style="endArrow=classic;html=1;fontSize=10;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="LS" target="EQ"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="notes" value="&lt;b&gt;Notes / assumptions&lt;/b&gt;&lt;br&gt;• J6 pin map from docs/Custom boards/tinyControlBoard/TinyControlboard.md §3; UART/handshake GPIOs from docs/DeveloperGuides/06-hardware-interface.md §3.&lt;br&gt;• &lt;b&gt;Conflict:&lt;/b&gt; the KiCad doc names GPIO9-14, 39, 47 as above, but firmware (06-hardware-interface.md §6) uses GPIO13 = 3.3 V rail, GPIO12 = DAC power, GPIO9 = output stage, GPIO11 = Pi power, GPIO10 = DAC signal-select, GPIO47/39 = general relays 1/2. Which J6 line carries which firmware function must be confirmed against the schematic.&lt;br&gt;• Likewise GPIO1/2 (firmware UART2 RX/TX) are listed as spare in the KiCad doc; GPIO41 is called esp_ir_sent on the board and ESP→Pi data-ready in firmware.&lt;br&gt;• Debug TX/RX are assumed to be UART0 (TXD0/RXD0 on the module); the doc does not give the exact mapping to J6 pins 5/6.&lt;br&gt;• Outputs are logic-level 5 V from a TXS0108E (documented as a poor fit for driving relays/mains directly); external driver stages and isolation are not on this board.&lt;br&gt;• J6 is identical to J3 (Molex 70246-4001) – do not cross the ribbon cables."
 style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fillColor=#ffffcc;strokeColor=#d6b656;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="1060" width="950" height="170" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
