        <mxCell id="c3" edge="1" parent="1" source="ESP" style="endArrow=classic;html=1;fontSize=10;strokeColor=#82b366;strokeWidth=2;" target="LS" value="3.3 V logic outputs">
          <mxGeometry relative="1" as="geometry" />
