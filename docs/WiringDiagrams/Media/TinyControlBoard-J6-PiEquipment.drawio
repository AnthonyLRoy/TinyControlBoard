        <mxCell id="c4" edge="1" parent="1" source="LS" style="endArrow=classic;html=1;fontSize=10;strokeColor=#82b366;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="p36" value="*_out (5 V) → J6">
