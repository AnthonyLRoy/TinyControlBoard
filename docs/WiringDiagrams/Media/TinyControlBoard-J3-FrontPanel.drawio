        <mxCell id="hdr2" parent="1" style="text;html=1;align=center;fontSize=14;" value="&lt;b&gt;Controller side of J3 (on the TinyControlBoard)&lt;/b&gt;" vertex="1">
          <mxGeometry height="24" width="400" x="300" y="690" as="geometry" />
        </mxCell>
        <mxCell id="MAX" parent="1" style="rounded=1;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;IC2 + IC3 · MAX6818&lt;/b&gt;&lt;br&gt;8-ch debouncer / ESD&lt;br&gt;btn_in_1..8 → btn_l_1..8 (IC2)&lt;br&gt;btn_in_9..16 → btn_l_9..16 (IC3)&lt;br&gt;3.3 V supply" vertex="1">
          <mxGeometry height="90" width="230" x="20" y="740" as="geometry" />
        </mxCell>
        <mxCell id="MCP" parent="1" style="rounded=1;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;IC5 · MCP23018&lt;/b&gt;&lt;br&gt;16-bit I2C expander, addr 0x20&lt;br&gt;GPA/GPB ← btn_l_1..16&lt;br&gt;(rotary A/B decoded in firmware)&lt;br&gt;INTA / INTB → ESP32" vertex="1">
          <mxGeometry height="90" width="230" x="20" y="890" as="geometry" />
        </mxCell>
        <mxCell id="ESP" parent="1" style="rounded=1;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;IC6 · ESP32-S3-WROOM-1U-N16&lt;/b&gt;&lt;br&gt;&lt;br&gt;GPIO15  I2C SCL (mcp_clk, 50 kHz)&lt;br&gt;GPIO16  I2C SDA (mcp_sda)&lt;br&gt;GPIO17  MCP23018 reset/enable&lt;br&gt;GPIO18  MCP interrupt (IntA)&lt;br&gt;GPIO8   MCP interrupt (IntB)&lt;br&gt;&lt;br&gt;GPIO7   STP16 SDI (data)&lt;br&gt;GPIO6   STP16 CLK&lt;br&gt;GPIO5   STP16 LE (latch)&lt;br&gt;GPIO21  STP16 OE / PWM (brightness)&lt;br&gt;&lt;br&gt;GPIO3   on_led (app active)&lt;br&gt;GPIO4   standby_led (sleep)" vertex="1">
          <mxGeometry height="250" width="240" x="380" y="740" as="geometry" />
        </mxCell>
        <mxCell id="STP" parent="1" style="rounded=1;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;IC1 · STP16CPC26&lt;/b&gt;&lt;br&gt;16-ch constant-current LED driver&lt;br&gt;OUT0..15 = led_o_1..16 (sinks)&lt;br&gt;R-EXT: R7 / R17 + VR1 trimmer&lt;br&gt;3.3 V supply" vertex="1">
          <mxGeometry height="90" width="230" x="740" y="740" as="geometry" />
        </mxCell>
        <mxCell id="PWR" parent="1" style="rounded=1;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b&gt;Power-state indicators&lt;/b&gt;&lt;br&gt;GPIO3 → R → ON LED (D1 on_led)&lt;br&gt;GPIO4 → R → STANDBY LED&lt;br&gt;Front-panel power indicator [18] shows ON / sleep; flashes during start-up&lt;br&gt;&lt;i&gt;(not routed through J3 – see notes)&lt;/i&gt;" vertex="1">
          <mxGeometry height="100" width="230" x="740" y="890" as="geometry" />
        </mxCell>
        <mxCell id="c1" edge="1" parent="1" source="j3" style="endArrow=classic;html=1;fontSize=10;strokeColor=#6c8ebf;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" target="MAX" value="btn_in_1..16">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="320" y="365" />
              <mxPoint x="320" y="785" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c2" edge="1" parent="1" source="MAX" style="endArrow=classic;html=1;fontSize=10;strokeColor=#6c8ebf;strokeWidth=2;" target="MCP" value="btn_l_1..16">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c3" edge="1" parent="1" source="MCP" style="endArrow=classic;startArrow=classic;html=1;fontSize=10;strokeColor=#d6b656;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" target="ESP" value="I2C SCL/SDA, RESET, INT">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c4" edge="1" parent="1" source="ESP" style="endArrow=classic;html=1;fontSize=10;strokeColor=#82b366;strokeWidth=2;" target="STP" value="SDI / CLK / LE / OE(PWM)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c5" edge="1" parent="1" source="STP" style="endArrow=classic;html=1;fontSize=10;strokeColor=#82b366;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" target="j3" value="led_o_1..16 (sink)">
          <mxGeometry relative="1" x="-0.641" y="-15" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="855" y="730" />
              <mxPoint x="490" y="730" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c6" edge="1" parent="1" source="ESP" style="endArrow=classic;html=1;fontSize=10;strokeColor=#b85450;strokeWidth=2;" target="PWR" value="GPIO3 / GPIO4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="notes" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fillColor=#ffffcc;strokeColor=#d6b656;spacing=6;" value="&lt;b&gt;Notes / assumptions&lt;/b&gt;&lt;br&gt;• J3 pin map from docs/Custom boards/tinyControlBoard/TinyControlboard.md §3; GPIOs from lib/board/boardConfig.hpp and docs/DeveloperGuides/06-hardware-interface.md.&lt;br&gt;• Button ID n (lib/board/boardButtonIds.hpp) is assumed to map to btn_in_(n+1); confirm against the KiCad schematic.&lt;br&gt;• Button inputs: normally-open switch from btn_in_n to GND (MAX6818 inputs). Power switch = ID 0 (short press Sleep/wake, ~3 s hold Deep Sleep).&lt;br&gt;• Rotary: phase A/B = IDs 13/14 (btn_in_14/15), decoded in lib/hal/buttons/mcpInputHandler.cpp. The documented encoder push switch is not identified in the sources – verify its input.&lt;br&gt;• LEDs: STP16 outputs are current sinks, so each LED anode goes to +5 V and cathode to led_o_n (verify on the front-panel PCB). J3 pins 32/34 are led_o_16/led_o_15 (out of sequence).&lt;br&gt;• Power indicators: the documentation lists no J3 pins for them; on_led (GPIO3) and standby_led (GPIO4) are on-board outputs. If the front-panel indicator is wired to them, they leave via test points, not J3. Verify. J3 pins 1/2 are N/C." vertex="1">
          <mxGeometry height="150" width="950" x="20" y="1020" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
