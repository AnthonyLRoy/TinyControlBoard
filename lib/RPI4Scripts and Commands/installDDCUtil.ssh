sudo apt-get install ddcutil -y


sudo apt-get install ddcutil -y

sudo ddcutil setvcp x y    :: where x is 10 for monitor  y  brightness between 0 and 100

ddcutil setvcp d6 5 # switch off monitor 
ddcutil setvcp d6 1 # switch monitor on
ddcutil capabilities # list monitor capabilities


